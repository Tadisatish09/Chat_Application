# Server Configuration
PORT=5000
JWT_SECRET=your_jwt_secret_key_here

# Aiven Cloud MySQL Configuration Option 1 (Single Connection URI)
DATABASE_URL=mysql://avnadmin:your_password@mysql-your-project.aivencloud.com:15678/defaultdb?ssl-mode=REQUIRED

# Aiven / Local MySQL Option 2 (Individual parameters)
DB_HOST=mysql-your-project.aivencloud.com
DB_PORT=15678
DB_USER=avnadmin
DB_PASSWORD=your_aiven_password
DB_NAME=defaultdb
DB_SSL=true

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
